# Cluster
CLUSTER_PROFILE=single-node
CLUSTER_NAME=k3d-lab

# k3d / k3s
K3S_IMAGE=rancher/k3s:v1.30.2-k3s2
K3D_REGISTRY_ENABLED=false
K3D_REGISTRY_NAME=k3d-registry.localhost
K3D_REGISTRY_PORT=5000

# Cilium
CILIUM_VERSION=1.15.6
CILIUM_CONNECTIVITY_TEST=false

# Gateway API
GATEWAY_API_VERSION=1.1.0

# Optional components
SERVICE_MESH=none          # none | istio
INGRESS_PROVIDER=cilium    # none | nginx | istio | cilium
INSTALL_METALLB=false
INSTALL_OBSERVABILITY=false
INSTALL_SECURITY=false

# Versions (sourced from versions.env if not set here)
ISTIO_VERSION=1.22.2
CERT_MANAGER_VERSION=1.15.1
KYVERNO_VERSION=3.2.6
EXTERNAL_SECRETS_VERSION=0.10.0
PROMETHEUS_STACK_VERSION=61.3.2
LOKI_VERSION=6.6.4
TEMPO_VERSION=1.10.3
OPENTELEMETRY_VERSION=0.102.1
METALLB_VERSION=0.14.5
NGINX_INGRESS_VERSION=4.10.1

# Namespaces
OBSERVABILITY_NAMESPACE=observability
ISTIO_NAMESPACE=istio-system
CERT_MANAGER_NAMESPACE=cert-manager
KYVERNO_NAMESPACE=kyverno
EXTERNAL_SECRETS_NAMESPACE=external-secrets
